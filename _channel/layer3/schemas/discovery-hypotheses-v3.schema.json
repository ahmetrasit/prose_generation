{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer3-discovery-hypotheses-v3.schema.json",
  "title": "Layer 3 blind image-system discovery hypotheses v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "sourceSetHash",
    "surah",
    "language",
    "hypotheses",
    "activationCardCoverage"
  ],
  "properties": {
    "schemaVersion": { "const": "layer3-discovery-hypotheses-v3" },
    "packetId": { "type": "string", "minLength": 1 },
    "sourceSetHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
    "language": { "type": "string", "pattern": "^[a-z]{2,8}(?:-[a-z0-9]{1,8})*$" },
    "hypotheses": {
      "type": "array",
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "activationCardCoverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/activationCoverage" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "ayahRef": { "type": "string", "pattern": "^[1-9][0-9]{0,2}:(?:0|[1-9][0-9]*)$" },
    "activationRef": { "type": "string", "pattern": "^activation:[a-z0-9][a-z0-9:-]*$" },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesisId",
        "readerName",
        "imageSystem",
        "systemBoundary",
        "proposedOperation",
        "readerShift",
        "memberSignals",
        "activationCardRefs"
      ],
      "properties": {
        "hypothesisId": { "$ref": "#/$defs/id" },
        "readerName": { "type": "string", "minLength": 1 },
        "imageSystem": { "type": "string", "minLength": 1 },
        "systemBoundary": { "type": "string", "minLength": 1 },
        "proposedOperation": { "type": "string", "minLength": 1 },
        "readerShift": { "$ref": "#/$defs/readerShift" },
        "memberSignals": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/memberSignal" }
        },
        "activationCardRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/activationRef" }
        }
      }
    },
    "readerShift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "hinge", "after"],
      "properties": {
        "before": { "type": "string", "minLength": 1 },
        "hinge": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "minLength": 1 }
      }
    },
    "memberSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ayahRef", "concreteContribution", "activationCardRefs"],
      "properties": {
        "ayahRef": { "$ref": "#/$defs/ayahRef" },
        "concreteContribution": { "type": "string", "minLength": 1 },
        "activationCardRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/activationRef" }
        }
      }
    },
    "activationCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationRef", "hypothesisIds", "searchNote"],
      "properties": {
        "activationRef": { "$ref": "#/$defs/activationRef" },
        "hypothesisIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "searchNote": { "type": "string", "minLength": 1 }
      }
    }
  }
}
