{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer3-source-packet-v1.schema.json",
  "title": "Layer 3 surah-reading source packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "surah",
    "language",
    "ayahs",
    "sources",
    "coverage",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "layer3-source-packet-v1"
    },
    "packetId": {
      "type": "string",
      "pattern": "^s[0-9]{3}-[a-z]{2,8}-layer3-v1$"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "ayahs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ayah"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quranText",
        "layer2",
        "networkV3",
        "v12",
        "v11"
      ],
      "properties": {
        "quranText": {
          "$ref": "#/$defs/coverageGroup"
        },
        "layer2": {
          "$ref": "#/$defs/coverageGroup"
        },
        "networkV3": {
          "$ref": "#/$defs/coverageGroup"
        },
        "v12": {
          "$ref": "#/$defs/coverageGroup"
        },
        "v11": {
          "$ref": "#/$defs/coverageGroup"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "ayahRef": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}:(?:0|[1-9][0-9]*)$"
    },
    "ayah": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ayahRef",
        "unitType",
        "arabic",
        "sourceRefs"
      ],
      "properties": {
        "ayahRef": {
          "$ref": "#/$defs/ayahRef"
        },
        "unitType": {
          "enum": [
            "basmala",
            "ayah"
          ]
        },
        "arabic": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "kind",
        "role",
        "path",
        "format",
        "content"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "kind": {
          "enum": [
            "quran-text",
            "layer2-prose",
            "layer2-evidence",
            "layer2-index",
            "layer2-friction",
            "network-review",
            "network-summary",
            "network-branch-catalog",
            "network-candidates",
            "network-families",
            "network-family-inventory",
            "network-path-families",
            "v12-publication",
            "v12-cross-run",
            "v11-root-audit",
            "v11-branches",
            "v11-bridge-candidates",
            "v11-activation",
            "v11-mechanism",
            "v11-secondary-expansion",
            "v11-final-report",
            "v11-ranking",
            "v11-holistic-reading"
          ]
        },
        "role": {
          "enum": [
            "primary-ground",
            "local-reading",
            "local-apparatus",
            "candidate-evidence",
            "reviewed-evidence",
            "legacy-recall",
            "production-context"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "json",
            "markdown",
            "tsv"
          ]
        },
        "transform": {
          "type": "string",
          "minLength": 1
        },
        "content": true
      }
    },
    "coverageGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required",
        "sourceIds",
        "missing",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "absent"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallbackUsed": {
          "type": "boolean"
        },
        "sourceRoot": {
          "type": "string"
        }
      }
    }
  }
}
