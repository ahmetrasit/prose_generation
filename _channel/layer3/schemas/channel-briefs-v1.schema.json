{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer3-channel-briefs-v1.schema.json",
  "title": "Layer 3 latent-dependent channel briefs v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "briefId",
    "packetId",
    "surah",
    "channels"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "layer3-channel-briefs-v1"
    },
    "briefId": {
      "type": "string",
      "pattern": "^s[0-9]{3}-channel-briefs-v1$"
    },
    "packetId": {
      "type": "string"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channel"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "ayahRef": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}:(?:0|[1-9][0-9]*)$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*(?:#.+)?$"
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channelId",
        "hypothesisIds",
        "surfaceFloor",
        "latentHinges",
        "crossAyahOperation",
        "readerShift",
        "indispensableGain",
        "doNotClaim"
      ],
      "properties": {
        "channelId": {
          "$ref": "#/$defs/id"
        },
        "hypothesisIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "surfaceFloor": {
          "type": "string",
          "minLength": 1
        },
        "latentHinges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/latentHinge"
          }
        },
        "crossAyahOperation": {
          "type": "string",
          "minLength": 1
        },
        "readerShift": {
          "$ref": "#/$defs/readerShift"
        },
        "indispensableGain": {
          "type": "string",
          "minLength": 1
        },
        "doNotClaim": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "latentHinge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contribution",
        "ayahRefs",
        "sourceRefs"
      ],
      "properties": {
        "contribution": {
          "type": "string",
          "minLength": 1
        },
        "ayahRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ayahRef"
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "readerShift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
