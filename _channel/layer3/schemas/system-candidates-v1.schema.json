{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer3-system-candidates-v1.schema.json",
  "title": "Layer 3 recall-first system candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "surah",
    "primaryMovement",
    "primaryTensions",
    "systems",
    "friction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "layer3-system-candidates-v1"
    },
    "packetId": {
      "type": "string"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "primaryMovement": {
      "type": "string",
      "minLength": 1
    },
    "primaryTensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "friction": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "ayahRef": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}:(?:0|[1-9][0-9]*)$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*(?:#.+)?$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemId",
        "workingName",
        "governingOperation",
        "primaryContainment",
        "wholeSurahShift",
        "ayahRefs",
        "trajectory",
        "evidenceContributions",
        "ahaMoments",
        "counterpressure",
        "coherence"
      ],
      "properties": {
        "systemId": {
          "$ref": "#/$defs/id"
        },
        "workingName": {
          "type": "string",
          "minLength": 1
        },
        "governingOperation": {
          "type": "string",
          "minLength": 1
        },
        "primaryContainment": {
          "type": "string",
          "minLength": 1
        },
        "wholeSurahShift": {
          "type": "string",
          "minLength": 1
        },
        "ayahRefs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ayahRef"
          }
        },
        "trajectory": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/trajectoryStage"
          }
        },
        "evidenceContributions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "ahaMoments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/aha"
          }
        },
        "counterpressure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/counterpressure"
          }
        },
        "coherence": {
          "$ref": "#/$defs/coherence"
        }
      }
    },
    "trajectoryStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageId",
        "movement",
        "ayahRefs",
        "sourceRefs"
      ],
      "properties": {
        "stageId": {
          "$ref": "#/$defs/id"
        },
        "movement": {
          "type": "string",
          "minLength": 1
        },
        "ayahRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ayahRef"
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributionId",
        "claim",
        "sourceRefs",
        "upstreamStatus",
        "role",
        "retainedContribution"
      ],
      "properties": {
        "contributionId": {
          "$ref": "#/$defs/id"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "upstreamStatus": {
          "enum": [
            "strong",
            "weak",
            "rejected-predication",
            "counterevidence",
            "ungraded"
          ]
        },
        "role": {
          "enum": [
            "core",
            "support",
            "contrast",
            "boundary"
          ]
        },
        "retainedContribution": {
          "type": "string",
          "minLength": 1
        },
        "prohibitedInference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ahaId",
        "before",
        "hinge",
        "after"
      ],
      "properties": {
        "ahaId": {
          "$ref": "#/$defs/id"
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "hinge": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counterpressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRefs",
        "pressure",
        "effect"
      ],
      "properties": {
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "pressure": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "narrows",
            "qualifies",
            "blocks"
          ]
        }
      }
    },
    "coherence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recursAcrossAyahs",
        "hasOrderedOperation",
        "explainsRatherThanLists",
        "primarySurvives",
        "uniqueWholeSurahYield",
        "explanation"
      ],
      "properties": {
        "recursAcrossAyahs": {
          "type": "boolean"
        },
        "hasOrderedOperation": {
          "type": "boolean"
        },
        "explainsRatherThanLists": {
          "type": "boolean"
        },
        "primarySurvives": {
          "type": "boolean"
        },
        "uniqueWholeSurahYield": {
          "type": "boolean"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
