{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quran.local/schemas/translation-authored-v1.schema.json",
  "title": "Translation layer v1 — authored content only",
  "description": "What a writer authors for one surah in one language: card and occurrence glosses keyed by QAC morpheme ref, and the fluent translation keyed by ayah ref. Identities, root and branch selections, and gloss IDs are assembled by tools/assemble.py from QAC morphology and the anchor seed, and are deliberately absent here — see README.md decision D1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "surah",
    "glosses",
    "ayat",
    "missingGlosses"
  ],
  "properties": {
    "schemaVersion": {
      "const": "translation-authored-v1"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "glosses": {
      "description": "One entry per QAC morpheme card, keyed by qacMorphemeRef. Rooted cards carry both `card` and `occurrence`; unrooted particles, articles, pronouns, and affixes carry `card` only.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/qacMorphemeRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/gloss"
      }
    },
    "ayat": {
      "description": "One entry per ayah, keyed by ayahRef.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/ayahRef"
      },
      "additionalProperties": {
        "$ref": "#/$defs/translation"
      }
    },
    "missingGlosses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missingGloss"
      }
    }
  },
  "$defs": {
    "ayahRef": {
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
    },
    "qacMorphemeRef": {
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*$"
    },
    "gloss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card"
      ],
      "properties": {
        "card": {
          "description": "Short occurrence label for the card. Not morphology jargon, dictionary prose, or commentary.",
          "type": "string",
          "minLength": 1
        },
        "occurrence": {
          "description": "Form-specific occurrence gloss. Required on rooted cards, absent on unrooted ones.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "targetTokens"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "targetTokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/targetToken"
          }
        }
      }
    },
    "targetToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "separatorAfter",
        "qacMorphemeRefs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "separatorAfter": {
          "type": "string"
        },
        "qacMorphemeRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/qacMorphemeRef"
          }
        }
      }
    },
    "missingGloss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qacMorphemeRef",
        "reason"
      ],
      "properties": {
        "qacMorphemeRef": {
          "$ref": "#/$defs/qacMorphemeRef"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
