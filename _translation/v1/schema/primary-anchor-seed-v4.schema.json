{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quran.local/schemas/primary-anchor-seed-v4.schema.json",
  "title": "Branch-only primary anchor seed v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surah", "anchors", "unresolved"],
  "properties": {
    "schemaVersion": { "const": "primary-anchor-seed-v4" },
    "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
    "anchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/anchor" }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["qacMorphemeRef", "reason"],
        "properties": {
          "qacMorphemeRef": { "$ref": "#/$defs/qacMorphemeRef" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "rootId": { "type": "string", "pattern": "^root_[0-9]{6}$" },
    "branchId": { "type": "string", "pattern": "^B[0-9]{3}$" },
    "qacMorphemeRef": {
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*$"
    },
    "rootBranches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootId", "branchIds"],
      "properties": {
        "rootId": { "$ref": "#/$defs/rootId" },
        "branchIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/branchId" }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qacMorphemeRef", "primary", "resonances"],
      "properties": {
        "qacMorphemeRef": { "$ref": "#/$defs/qacMorphemeRef" },
        "primary": { "$ref": "#/$defs/rootBranches" },
        "resonances": {
          "type": "array",
          "items": { "$ref": "#/$defs/rootBranches" }
        }
      }
    }
  }
}
