# Derived and bulk data stay local. Briefs, scripts, schema, accepted pages (out/) and the run records under work/
# (prompts, outputs, logs) are versioned; the pack (copies of the base and of licensed lexicon texts) is rebuilt.
.cache/
__pycache__/
fetch/openiti_cache/
work/*/pack/
work/*/*/run.stream.jsonl
work/*/*/preview/
# call directories: version the run record only, not the agent's scratch notes (copies of corpus text)
work/*/zengin.*/*
!work/*/zengin.*/prompt.md
!work/*/zengin.*/command.json
!work/*/zengin.*/started.json
!work/*/zengin.*/run.log.json
!work/*/zengin.*/stderr.log
!work/*/zengin.*/response.md
!work/*/zengin.*/annotations.jsonl
!work/*/zengin.*/gaps.json
!work/*/zengin.*/check.json
work/*/_sandboxtest/
