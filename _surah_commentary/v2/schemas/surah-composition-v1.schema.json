{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer3-surah-composition-v1.schema.json",
  "title": "Layer 3 surah composition envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compositionId",
    "packetId",
    "briefId",
    "sourceSetHash",
    "surah",
    "language",
    "prose",
    "evidenceMap",
    "friction"
  ],
  "properties": {
    "schemaVersion": { "const": "layer3-surah-composition-v1" },
    "compositionId": { "type": "string", "minLength": 1 },
    "packetId": { "type": "string", "minLength": 1 },
    "briefId": { "type": "string", "minLength": 1 },
    "sourceSetHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
    "language": { "type": "string", "pattern": "^[a-z]{2,8}(?:-[a-z0-9]{1,8})*$" },
    "prose": { "type": "string", "minLength": 1 },
    "evidenceMap": { "$ref": "#/$defs/evidenceMap" },
    "friction": { "type": "array", "items": { "$ref": "#/$defs/frictionItem" } }
  },
  "$defs": {
    "ayahRef": { "type": "string", "pattern": "^[1-9][0-9]{0,2}:(?:0|[1-9][0-9]*)$" },
    "sourceRef": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*(?:#.+)?$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "primaryClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "ayahRefs", "span", "sourceRefs"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "ayahRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ayahRef" } },
        "span": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "channelLanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channelId", "operationSpan", "gainSpan", "evidenceRefs"],
      "properties": {
        "channelId": { "$ref": "#/$defs/id" },
        "operationSpan": { "type": "string", "minLength": 1 },
        "gainSpan": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "hingeLanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hingeId", "span", "evidenceRefs"],
      "properties": {
        "hingeId": { "$ref": "#/$defs/id" },
        "span": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "evidenceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryClaims", "channelLandings", "hingeLandings"],
      "properties": {
        "primaryClaims": { "type": "array", "items": { "$ref": "#/$defs/primaryClaim" } },
        "channelLandings": { "type": "array", "items": { "$ref": "#/$defs/channelLanding" } },
        "hingeLandings": { "type": "array", "items": { "$ref": "#/$defs/hingeLanding" } }
      }
    },
    "frictionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
