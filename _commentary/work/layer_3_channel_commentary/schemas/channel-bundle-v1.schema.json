{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "channel-bundle-v1.schema.json",
  "title": "Lean combined channel-commentary input bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleType",
    "surah",
    "reviewedChannels",
    "text",
    "anchorInventory",
    "motifAnchorMap",
    "primaryFloor",
    "primaryBranchMap",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "channel-bundle-v1"
    },
    "bundleType": {
      "const": "combined-channel-commentary"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "reviewedChannels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_channels"
      ],
      "properties": {
        "parent_channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parentChannel"
          }
        }
      }
    },
    "text": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ayahRef",
          "arabic_uthmani"
        ],
        "properties": {
          "ayahRef": {
            "type": "string"
          },
          "arabic_uthmani": {
            "type": "string"
          }
        }
      }
    },
    "anchorInventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "motifAnchorMap": {
      "$ref": "#/$defs/motifAnchorMap"
    },
    "primaryFloor": {
      "oneOf": [
        {
          "$ref": "#/$defs/authoredFloor"
        },
        {
          "$ref": "#/$defs/arabicFloor"
        }
      ]
    },
    "primaryBranchMap": {
      "$ref": "#/$defs/primaryBranchMap"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    }
  },
  "$defs": {
    "parentChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "semantic_invariant",
        "surface_relation",
        "surprising_reach",
        "subchannels"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "name": {
          "type": "string"
        },
        "semantic_invariant": {
          "type": "string"
        },
        "surface_relation": {
          "type": "string"
        },
        "surprising_reach": {
          "type": "string"
        },
        "reading_type": {
          "type": "string"
        },
        "active_motifs": {
          "type": "string"
        },
        "synthesis": {
          "type": "string"
        },
        "ayah_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subchannels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subchannel"
          }
        }
      }
    },
    "subchannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "reading_type",
        "active_motifs",
        "synthesis",
        "ayah_refs"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "reading_type": {
          "type": "string"
        },
        "active_motifs": {
          "type": "string"
        },
        "synthesis": {
          "type": "string"
        },
        "ayah_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorId",
        "ayahRef",
        "qacMorphemeRef",
        "surface_ar",
        "root_ar",
        "rootId",
        "rootOccurrenceStatus"
      ],
      "properties": {
        "anchorId": {
          "type": "string",
          "pattern": "^a[0-9]{3}-[0-9]{4}$"
        },
        "ayahRef": {
          "type": "string"
        },
        "qacMorphemeRef": {
          "type": "string"
        },
        "surface_ar": {
          "type": "string"
        },
        "root_ar": {
          "type": "string",
          "minLength": 1
        },
        "rootId": {
          "type": "string",
          "pattern": "^root_[0-9]{6}$"
        },
        "rootOccurrenceStatus": {
          "enum": [
            "resolved",
            "ambiguous-root"
          ]
        },
        "ambiguityReasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "root-id"
            ]
          },
          "description": "Unresolved identity only. Recurrence is not an ambiguity."
        },
        "candidateRootIds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^root_[0-9]{6}$"
          }
        },
        "recurrenceRefs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Every qacMorphemeRef in this surah carrying the same rootId. Recurrence evidence for membership criterion 3, not an ambiguity."
        }
      }
    },
    "motifAnchorMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "patternProperties": {
          "^B[0-9]{3}$": {
            "type": "object",
            "patternProperties": {
              "^(m[0-9]{2,}|_)$": {
                "$ref": "#/$defs/motifAnchor"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "motifAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorIds",
        "rootOccurrenceStatus"
      ],
      "properties": {
        "anchorIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^a[0-9]{3}-[0-9]{4}$"
          }
        },
        "rootOccurrenceStatus": {
          "enum": [
            "resolved",
            "ambiguous-root",
            "unmatched"
          ]
        }
      }
    },
    "primaryBranchMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "entries"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "absent",
            "ambiguous-source",
            "invalid-source"
          ]
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coveredChannelAnchorCount": {
          "type": "integer",
          "minimum": 0
        },
        "channelAnchorCount": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "qacMorphemeRef",
              "rootId",
              "primaryBranchIds"
            ],
            "properties": {
              "qacMorphemeRef": {
                "type": "string"
              },
              "rootId": {
                "type": "string",
                "pattern": "^root_[0-9]{6}$"
              },
              "primaryBranchIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^B[0-9]{3}$"
                }
              }
            }
          }
        }
      }
    },
    "authoredFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "language",
        "sourcePath",
        "sourceSha256",
        "lines"
      ],
      "properties": {
        "status": {
          "const": "authored"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ayahRef",
              "text"
            ],
            "properties": {
              "ayahRef": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "arabicFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "arabic-only-inference"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedChannels",
        "primaryFloor",
        "primaryBranchMap",
        "identityMappings"
      ],
      "properties": {
        "reviewedChannels": {
          "type": "object"
        },
        "primaryFloor": {
          "type": "object"
        },
        "primaryBranchMap": {
          "type": "object"
        },
        "identityMappings": {
          "type": "object"
        }
      }
    }
  }
}
