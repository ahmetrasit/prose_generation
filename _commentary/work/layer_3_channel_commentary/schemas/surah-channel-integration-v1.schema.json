{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "surah-channel-integration-v1.schema.json",
  "title": "Layer 3 reviewed-channel integration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surah",
    "sourceLane",
    "sourceBundle",
    "sourceBundleSha256",
    "primaryFloorBasis",
    "channels",
    "sourceCoverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "surah-channel-integration-v1"
    },
    "surah": {
      "type": "integer",
      "minimum": 1,
      "maximum": 114
    },
    "sourceLane": {
      "const": "combined-layer3-layer2.5"
    },
    "sourceBundle": {
      "type": "string",
      "minLength": 1
    },
    "sourceBundleSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "primaryFloorBasis": {
      "$ref": "#/$defs/primaryFloorBasis"
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "sourceCoverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceCoverage"
      }
    }
  },
  "$defs": {
    "relation": {
      "enum": [
        "supports-primary",
        "shifts-primary"
      ]
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channelId",
        "name_tr",
        "statement_tr",
        "wholeSurahRelation",
        "wholeSurahShift_tr",
        "sourceChannels",
        "members",
        "maturityStatus",
        "maturityByAyah"
      ],
      "properties": {
        "channelId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name_tr": {
          "type": "string",
          "minLength": 1
        },
        "statement_tr": {
          "type": "string",
          "minLength": 1
        },
        "wholeSurahRelation": {
          "$ref": "#/$defs/relation"
        },
        "wholeSurahShift_tr": {
          "type": "string",
          "minLength": 1
        },
        "sourceChannels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^P[0-9]{2}(?:/[^/]+)?$"
          }
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "maturityStatus": {
          "const": "derived"
        },
        "maturityByAyah": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/maturity"
          }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "ayahRef",
        "qacMorphemeRef",
        "rootId",
        "branchId",
        "primaryStatus",
        "surface_tr",
        "contribution_tr",
        "evidenceRefs"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "ayahRef": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$"
        },
        "qacMorphemeRef": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,2}:[1-9][0-9]*:[1-9][0-9]*$"
        },
        "rootId": {
          "type": "string",
          "pattern": "^root_[0-9]{6}$"
        },
        "branchId": {
          "type": "string",
          "pattern": "^B[0-9]{3}$"
        },
        "motifId": {
          "type": "string",
          "pattern": "^m[0-9]{2,}$"
        },
        "primaryStatus": {
          "enum": [
            "primary",
            "non-primary",
            "unknown"
          ]
        },
        "surface_tr": {
          "type": "string",
          "minLength": 1
        },
        "contribution_tr": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ayahRef",
        "state",
        "newMemberIds",
        "recalledMemberIds",
        "cumulativeImage_tr"
      ],
      "properties": {
        "ayahRef": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$"
        },
        "state": {
          "enum": [
            "latent",
            "emerging",
            "mature",
            "complete"
          ]
        },
        "newMemberIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recalledMemberIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "focusAyahRelation": {
          "$ref": "#/$defs/relation"
        },
        "focusAyahShift_tr": {
          "type": "string"
        },
        "relationStatus": {
          "enum": [
            "statable",
            "not-yet-statable"
          ]
        },
        "cumulativeImage_tr": {
          "type": "string",
          "minLength": 1
        },
        "disclosure_tr": {
          "type": "string"
        }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRef",
        "disposition",
        "channelIds"
      ],
      "properties": {
        "sourceRef": {
          "type": "string",
          "pattern": "^P[0-9]{2}(?:/[^/]+)?$"
        },
        "disposition": {
          "enum": [
            "integrated",
            "apparatus-only"
          ]
        },
        "channelIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "reason_tr": {
          "type": "string"
        }
      }
    },
    "primaryFloorBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "apparatusStatus"
      ],
      "properties": {
        "status": {
          "enum": [
            "authored",
            "arabic-only-inference"
          ]
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "apparatusStatus": {
          "enum": [
            "canonical-translation-floor",
            "writer-primary-inference"
          ]
        }
      }
    }
  }
}
