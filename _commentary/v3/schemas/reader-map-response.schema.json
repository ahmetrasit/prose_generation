{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commentary-v3-reader-map-response-v1",
  "title": "Commentary v3 reader presentation map response",
  "type": "object",
  "required": ["schema_version", "identity", "blocks"],
  "properties": {
    "schema_version": {"const": "commentary-v3-reader-map-response-v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/block"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "required": [
        "ayah_ref",
        "editorial_prose_sha256",
        "editorial_index_sha256",
        "paragraph_inventory_sha256",
        "prompt_sha256"
      ],
      "properties": {
        "ayah_ref": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "editorial_prose_sha256": {"$ref": "#/$defs/sha256"},
        "editorial_index_sha256": {"$ref": "#/$defs/sha256"},
        "paragraph_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "block_key",
        "movement_key",
        "paragraph_keys",
        "role",
        "core_reasons",
        "detail_kinds",
        "label_tr",
        "surprise_refs"
      ],
      "properties": {
        "block_key": {"type": "string", "pattern": "^b[0-9]{3,}$"},
        "movement_key": {"type": "string", "pattern": "^m[0-9]{3,}$"},
        "paragraph_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^p[0-9]{3,}$"}
        },
        "role": {"enum": ["core", "detail"]},
        "core_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "plain_reading",
              "surprise_carrier",
              "surprise_payoff",
              "continuity",
              "closure"
            ]
          }
        },
        "detail_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "language_and_structure",
              "nearby_context",
              "wider_connections",
              "exploratory_reading"
            ]
          }
        },
        "label_tr": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 160}
          ]
        },
        "surprise_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^surprise:[a-z0-9][a-z0-9_.:-]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "core"}}},
          "then": {
            "properties": {
              "core_reasons": {"minItems": 1},
              "detail_kinds": {"maxItems": 0},
              "label_tr": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"role": {"const": "detail"}}},
          "then": {
            "properties": {
              "core_reasons": {"maxItems": 0},
              "detail_kinds": {"minItems": 1},
              "label_tr": {"type": "string", "minLength": 1},
              "surprise_refs": {"maxItems": 0}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
