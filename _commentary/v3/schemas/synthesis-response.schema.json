{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commentary-v3-synthesis-response-v1",
  "title": "Commentary v3 raw synthesis response",
  "type": "object",
  "required": ["schema_version", "identity", "paragraphs", "findings", "friction_notes"],
  "properties": {
    "schema_version": {"const": "commentary-v3-synthesis-response-v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "paragraphs": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/paragraph"}
    },
    "findings": {
      "type": "array", "minItems": 1, "maxItems": 48,
      "items": {"$ref": "#/$defs/finding"}
    },
    "friction_notes": {
      "type": "array", "maxItems": 12,
      "items": {"$ref": "#/$defs/friction"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "required": [
        "ayah_ref", "source_canonical_sha256", "docket_payload_sha256",
        "adjudication_payload_sha256", "synthesis_packet_sha256", "prompt_sha256"
      ],
      "properties": {
        "ayah_ref": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
        "source_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "docket_payload_sha256": {"$ref": "#/$defs/sha256"},
        "adjudication_payload_sha256": {"$ref": "#/$defs/sha256"},
        "synthesis_packet_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "candidateId": {"type": "string", "pattern": "^(cand|new)_[0-9a-f]{20}$"},
    "supportId": {"type": "string", "pattern": "^sup_[0-9a-f]{20}$"},
    "branchRef": {"type": "string", "pattern": "^root_[0-9]+/B[0-9]+$"},
    "paragraph": {
      "type": "object",
      "required": ["paragraph_key", "text", "finding_keys"],
      "properties": {
        "paragraph_key": {"type": "string", "pattern": "^p[0-9]{2}$"},
        "text": {"type": "string", "minLength": 1},
        "finding_keys": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/key"}
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_key", "title", "summary", "effect", "epistemic_status",
        "candidate_ids", "support_ids", "branch_refs", "paragraph_key",
        "landing_quote", "containment_quote"
      ],
      "properties": {
        "finding_key": {"$ref": "#/$defs/key"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "effect": {"enum": ["baseline", "supports_primary", "shifts_primary"]},
        "epistemic_status": {"enum": ["bundle_traceable", "inference", "exploratory"]},
        "candidate_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidateId"}},
        "support_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/supportId"}},
        "branch_refs": {"type": "array", "items": {"$ref": "#/$defs/branchRef"}},
        "paragraph_key": {"type": "string", "pattern": "^p[0-9]{2}$"},
        "landing_quote": {"type": "string", "minLength": 1},
        "containment_quote": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "friction": {
      "type": "object",
      "required": ["kind", "summary", "candidate_ids", "support_ids"],
      "properties": {
        "kind": {"enum": ["live_alternative", "scope_limit", "evidence_gap", "production"]},
        "summary": {"type": "string", "minLength": 1},
        "candidate_ids": {"type": "array", "items": {"$ref": "#/$defs/candidateId"}},
        "support_ids": {"type": "array", "items": {"$ref": "#/$defs/supportId"}}
      },
      "additionalProperties": false
    }
  }
}
