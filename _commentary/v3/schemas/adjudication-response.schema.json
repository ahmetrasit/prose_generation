{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commentary-v3-adjudication-response-v2",
  "title": "Commentary v3 raw adjudication response",
  "type": "object",
  "required": [
    "schema_version", "identity", "decisions", "new_candidates",
    "discovery_complete", "branch_review"
  ],
  "properties": {
    "schema_version": {"const": "commentary-v3-adjudication-response-v2"},
    "identity": {"$ref": "#/$defs/identity"},
    "discovery_complete": {"type": "boolean"},
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "new_candidates": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/proposal"}
    },
    "branch_review": {
      "type": "array",
      "items": {"$ref": "#/$defs/branchReview"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ayahRef": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
    "supportId": {"type": "string", "pattern": "^sup_[0-9a-f]{20}$"},
    "branchRef": {"type": "string", "pattern": "^root_[0-9]+/B[0-9]+$"},
    "identity": {
      "type": "object",
      "required": [
        "ayah_ref", "source_canonical_sha256", "docket_payload_sha256",
        "prompt_sha256"
      ],
      "properties": {
        "ayah_ref": {"$ref": "#/$defs/ayahRef"},
        "source_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "docket_payload_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "candidate_id", "status", "priority", "rationale", "synthesis_claim",
        "reader_payoff", "containment", "selection_basis", "support_quote",
        "exclusion_basis", "support_ids", "branch_refs"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^cand_[0-9a-f]{20}$"},
        "status": {"enum": ["selected", "rejected", "deferred"]},
        "priority": {"type": ["string", "null"], "enum": ["core", "supporting", null]},
        "rationale": {"type": "string", "minLength": 1},
        "synthesis_claim": {"type": ["string", "null"]},
        "reader_payoff": {"type": ["string", "null"]},
        "containment": {"type": ["string", "null"]},
        "selection_basis": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/selectionBasis"}]
        },
        "support_quote": {"$ref": "#/$defs/supportQuote"},
        "exclusion_basis": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/exclusionBasis"}]
        },
        "support_ids": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/supportId"}
        },
        "branch_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/branchRef"}
        }
      },
      "anyOf": [
        {
          "properties": {
            "status": {"const": "selected"}
          }
        },
        {
          "properties": {
            "status": {"enum": ["rejected", "deferred"]},
            "rationale": {"type": "string", "minLength": 48, "maxLength": 1200}
          }
        }
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "required": [
        "proposal_key", "title", "lane", "scope", "claim", "mechanism",
        "reader_payoff", "containment", "confidence", "anchor_refs",
        "selection_basis", "support_quote", "support_ids", "branch_refs"
      ],
      "properties": {
        "proposal_key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
        "title": {"type": "string", "minLength": 1},
        "lane": {"enum": ["micro", "macro", "global"]},
        "scope": {"enum": ["focus_ayah", "pericope", "surah", "cross_surah"]},
        "claim": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "reader_payoff": {"type": "string", "minLength": 1},
        "containment": {"type": "string", "minLength": 1},
        "selection_basis": {"$ref": "#/$defs/selectionBasis"},
        "support_quote": {"$ref": "#/$defs/supportQuote"},
        "confidence": {"enum": ["strong", "moderate", "exploratory"]},
        "anchor_refs": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/ayahRef"}
        },
        "support_ids": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/supportId"}
        },
        "branch_refs": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/branchRef"}
        }
      },
      "additionalProperties": false
    },
    "branchReview": {
      "type": "object",
      "required": [
        "branch_ref", "registry", "status", "activation_refs", "reason_code", "reason",
        "support_ids", "unactivation_basis", "contact_evidence"
      ],
      "properties": {
        "branch_ref": {"$ref": "#/$defs/branchRef"},
        "registry": {"enum": ["focus", "nominated"]},
        "status": {"enum": ["activated", "unactivated"]},
        "activation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(cand_[0-9a-f]{20}|new:[a-z][a-z0-9_-]{2,63})$"
          }
        },
        "reason_code": {
          "enum": [
            "supported_activation", "no_supported_contact", "insufficient_evidence",
            "scope_blocked", "lexical_overreach"
          ]
        },
        "reason": {"type": "string", "minLength": 24, "maxLength": 400},
        "support_ids": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/supportId"}
        },
        "unactivation_basis": {
          "anyOf": [{"type": "null"}, {"$ref": "#/$defs/unactivationBasis"}]
        },
        "contact_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/contactEvidence"}
        }
      },
      "anyOf": [
        {
          "properties": {
            "unactivation_basis": {"type": "null"},
            "reason_code": {"const": "supported_activation"}
          }
        },
        {
          "properties": {
            "unactivation_basis": {
              "type": "object",
              "properties": {"kind": {"const": "grounding_only"}},
              "required": ["kind"]
            },
            "reason_code": {"const": "no_supported_contact"}
          }
        },
        {
          "properties": {
            "unactivation_basis": {
              "type": "object",
              "properties": {"kind": {"const": "candidate_evidence_rejected"}},
              "required": ["kind"]
            },
            "reason_code": {
              "enum": ["insufficient_evidence", "scope_blocked", "lexical_overreach"]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "selectionBasis": {
      "type": "object",
      "required": ["kind", "deletion_loss", "subsumes_candidate_ids"],
      "properties": {
        "kind": {"enum": ["mandatory", "distinct"]},
        "deletion_loss": {"type": "string", "minLength": 24, "maxLength": 400},
        "subsumes_candidate_ids": {
          "type": "array", "maxItems": 0,
          "items": {"type": "string", "pattern": "^cand_[0-9a-f]{20}$"}
        }
      },
      "additionalProperties": false
    },
    "supportQuote": {
      "type": "object",
      "required": ["support_id", "quote"],
      "properties": {
        "support_id": {"$ref": "#/$defs/supportId"},
        "quote": {"type": "string", "minLength": 12, "maxLength": 320}
      },
      "additionalProperties": false
    },
    "exclusionBasis": {
      "type": "object",
      "required": ["reason_code", "duplicate_of_candidate_ids"],
      "properties": {
        "reason_code": {
          "enum": [
            "unsupported", "unsafe", "out_of_scope", "semantic_duplicate"
          ]
        },
        "duplicate_of_candidate_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^cand_[0-9a-f]{20}$"}
        }
      },
      "additionalProperties": false
    },
    "unactivationBasis": {
      "type": "object",
      "required": ["kind", "candidate_ids", "support_ids"],
      "properties": {
        "kind": {"enum": ["grounding_only", "candidate_evidence_rejected"]},
        "candidate_ids": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^cand_[0-9a-f]{20}$"}
        },
        "support_ids": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/supportId"}
        }
      },
      "additionalProperties": false
    },
    "contactEvidence": {
      "type": "object",
      "required": [
        "activation_ref", "support_id", "quote", "contact_mode", "contact_claim"
      ],
      "properties": {
        "activation_ref": {
          "type": "string",
          "pattern": "^(cand_[0-9a-f]{20}|new:[a-z][a-z0-9_-]{2,63})$"
        },
        "support_id": {"$ref": "#/$defs/supportId"},
        "quote": {"type": "string", "minLength": 12, "maxLength": 320},
        "contact_mode": {"enum": ["source_explicit", "bounded_inference"]},
        "contact_claim": {"type": "string", "minLength": 24, "maxLength": 500}
      },
      "additionalProperties": false
    }
  }
}
