            "discovery:reader_payoff",
            "discovery:containment",
            "obligation:cand_500ebfce0ccc281e8ffb"
          ],
          "paragraph": 14,
          "anchor": "Fiilin ilk ve ikinci görünüşü, bir defalık yaklaşmadan çok yinelemeyi ve gidip gelmeyi düşündüren sesli bir geri dönüş oluşturur."
        }
      ]
    },
    {
      "finding_ref": "micro:cand_e11264f5ceb4549ddee7",
      "landings": [
        {
          "movement_refs": [
            "discovery:claim",
            "discovery:mechanism",
            "discovery:reader_payoff",
            "discovery:containment",
            "obligation:cand_e11264f5ceb4549ddee7"
          ],
          "paragraph": 3,
          "anchor": "{ar:يُوسُفَ, tr:yūsufa, gloss:Yusuf} bu yapının mef'ulüdür; adı doğrudan anılsa da fiilin faili değildir."
        }
      ]
    },
    {
      "finding_ref": "micro:cand_8779febcd53ab1a5763d",
      "landings": [
