            "discovery:mechanism",
            "discovery:reader_payoff",
            "discovery:containment",
            "obligation:cand_695ac7d732750ed5dfdc"
          ],
          "paragraph": 10,
          "anchor": "{ar:أَنَا, tr:anā, gloss:ben} fiilin zaten taşıdığı birinci şahıs bilgisini ayrıca öne çıkararak hakikati belirli bir failin üzerine yerleştirir."
        }
      ]
    },
    {
