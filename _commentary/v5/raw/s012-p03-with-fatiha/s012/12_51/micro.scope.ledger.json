          ],
          "paragraph": 3,
          "anchor": "Bu sahiplikli nefis kalıbının 12:23, 12:26, 12:30 ve 12:32'deki önceki baştan çıkarma çerçevesinden sonra yeniden görünmesi, korunan kendilik temasını 12:51'de itirafın içine geri getirir."
        }
      ]
    },
    {
      "finding_ref": "micro:cand_459605c7fc669ab3ad1f",
      "landings": [
        {
          "movement_refs": [
            "discovery:claim",
            "discovery:mechanism",
            "discovery:reader_payoff",
            "discovery:containment",
            "obligation:cand_459605c7fc669ab3ad1f"
          ],
          "paragraph": 4,
          "anchor": "{ar:قُلْنَ, tr:qulna, gloss:topluca dediler} fiili, sorgulanan kadınları tek bir dişil çoğul tanıklık gövdesi olarak konuşturur ve ileride gelecek tekil itiraf için ortak ses ile sorumlu kişi arasına bir sınır koyar."
        }
      ]
    },
    {
      "finding_ref": "micro:cand_58e9349f6adfaafe4860",
