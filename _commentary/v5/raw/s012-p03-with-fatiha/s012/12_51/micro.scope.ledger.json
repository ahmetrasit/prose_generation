          ],
          "paragraph": 4,
          "anchor": "{ar:حَاشَ, tr:ḥāsha, gloss:suçu uzaklaştıran donmuş söz} cevabı, açık hukuki inkâr gelmeden önce suçu dışarı iten bir arındırma hareketi gerçekleştirir."
        }
      ]
    },
    {
      "finding_ref": "micro:cand_24e93643e3b5e7a8a347",
      "landings": [
        {
          "movement_refs": [
