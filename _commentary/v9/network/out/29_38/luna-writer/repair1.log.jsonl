acet_id\":\"F004\",\"role\":\"associated_use\",\"statement\":\"Savaşta yaş ve bilgi sahibi kişilerden yardım isteme söyleyişi, deneyim niteliğine dayanan bir kullanımdır.\"}]},\"contextual_glosses\":[{\"applicability\":\"Hayvanın ileri yaşını bildiren olağan bağlamlarda kullanılır; kalan güç bağlamdan anlaşılabilir.\",\"error_profile\":{\"adds\":null,\"collision\":null,\"fit\":\"narrowing\",\"loses\":\"Hayvanda bir miktar güç kalması niteliğini açıkça söylemez.\",\"preserves\":\"Temel hayvan türünü ve ileri yaşı korur.\"},\"facet_ids\":[\"F001\"],\"text\":\"yaşlı deve\",\"usage_role\":\"general\"},{\"applicability\":\"Bir hayvanın veya insanın ileri yaşa ulaşmasını bildiren türemiş eylem bağlamında uygundur.\",\"error_profile\":{\"adds\":null,\"collision\":null,\"fit\":\"narrowing\",\"loses\":\"Yaşlı deve adını ve deneyimli kişiden yardım isteme söyleyişini dışarıda bırakır.\",\"preserves\":\"İleri yaşa ulaşma sürecini korur.\"},\"facet_ids\":[\"F003\"],\"text\":\"yaşlanmak\",\"usage_role\":\"contextual\"}],\"excluded_glosses\":[],\"identity_judgment\":{\"boundary_note\":\"Temel gönderge yaşlı devedir; koyun kapsamı aktarıma bağlıdır, insanda ise ad değil yaşlanma eylemi ve deneyimli yaşlıya dayanan bir söyleyiş vardır.\",\"rationale\":\"Kaynak ifadesi yaşlı ve gücünden bir miktar kalmış deveyi merkezleştirir; bazı aktarımlar dişi koyunu da kapsar ve yaşlanma eylemini insana genişletir. Geçici açıklamadaki at kapsamı kaynak ifadesinde desteklenmediğinden tanımdan çıkarılmıştır.\",\"status\":\"reframed\"},\"lexical_glosses\":[{\"lexical_unit_id\":\"lu_026\",\"rendering_kind\":\"ordinary\",\"target_gloss\":\"gücü kalmış yaşlı deve\"},{\"lexical_unit_id\":\"lu_027\",\"rendering_kind\":\"ordinary\",\"target_gloss\":\"yaşlı dişi deve veya koyun\"},{\"lexical_unit_id\":\"lu_028\",\"rendering_kind\":\"ordinary\",\"target_gloss\":\"ileri yaşa ulaşmak\"},{\"lexical_unit_id\":\"lu_029\",\"rendering_kind\":\"ordinary\",\"target_gloss\":\"savaşta yaşlı ve deneyimli kişilerden y