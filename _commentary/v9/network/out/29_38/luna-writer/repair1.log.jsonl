endering_kind\":\"ordinary\",\"target_gloss\":\"önceki işe yeniden dönmek\"},{\"lexical_unit_id\":\"lu_006\",\"rendering_kind\":\"ordinary\",\"target_gloss\":\"aynı soruyu tekrar tekrar sormak\"},{\"lexical_unit_id\":\"lu_007\",\"rendering_kind\":\"ordinary\",\"target_gloss\":\"ateşi yeniden nüksetmek\"},{\"lexical_unit_id\":\"lu_008\",\"rendering_kind\":\"ordinary\",\"target_gloss\":\"önceden yenmişken yeniden sunulan yemek\"},{\"lexical_unit_id\":\"lu_009\",\"rendering_kind\":\"ordinary\",\"target_gloss\":\"sık sık dönen; geri dön buyruğu\"}],\"lexicalization_scope\":{\"branch_kind\":\"mixed_non_bare\",\"note\":\"Tanım yalın dönüş çekirdeğini korur; ettirgen, isteme bildiren ve kalıplaşmış kullanımları bu çekirdeğe bağlı ayrı gerçekleşmeler olarak sınırlar.\"},\"neighbor_coverage_note\":\"Bütün adaylar değerlendirildi; dönüşün yönü ile yinelemenin kapsamını en açık gösteren iki yakın anlamlı komşu seçildi.\",\"neighbor_distinctions\":[{\"boundary_match\":\"partial\",\"distinction\":\"Odak dal dönüşten yineleme ve yeniden yapma anlamlarına açılır; komşu dal ise öznenin dönüşüyle birlikte başka bir şeyi önceki durumuna geri götürmeyi merkezleştirir.\",\"focus_only\":\"Odak dal, geri dönüşün yanı sıra eylemin tekrarı ile yeniden yaptırma ve isteme biçimlerini de kapsar.\",\"gloss\":\"geri dönme ve geri döndürme\",\"neighbor_only\":\"Komşu dal, bir şeyi başladığı yön ya da önceki durumuna geri çevirme anlamını ayrıca kapsar.\",\"neighbor_ref\":\"root_000544/B001\",\"relation_type\":\"near_synonym\",\"shared_zone\":\"Her iki dal da önceki bir yer, yön veya duruma dönüşü anlatır.\"},{\"boundary_match\":\"partial\",\"distinction\":\"Komşu dalın çekirdeği sayılı ya da yinelenen tekrardır; odak dalın çekirdeği daha geniştir ve basit geri dönüşü de içerir.\",\"focus_only\":\"Odak dal tek bir geri dönüşü ve ayrılınan şeye yeniden yönelmeyi de kapsar.\",\"gloss\":\"bir şeyi yeniden yapma\",\"neighbor_only\":\"Komşu dal, yinelemeyi özellikle iki kez veya tekrar tekrar gerçekle