 \"B\", \"node_id\": \"quranic:root_000796:B004\", \"word\": \"F:10\", \"root\": \"ش ط ن\", \"root_id\": \"root_000796\", \"bid\": \"B004\", \"root_kind\": \"identity\", \"gloss\": \"azgın ve başkaldıran kötü varlık\", \"image\": \"الشيطان العاتي المتمرد\", \"src\": \"كل عات متمرد من الجن والإنس والدواب شيطان (maqayis;sihah)؛ الشيطان فيعال من شطن أي بعد وشيطن الرجل وتشيطن إذا صار كالشيطان وفعل فعله (tahdhib)؛ الشيطان اسم لكل عارم من الجن والإنس والحيوانات وسمي كل خلق ذميم للإنسان شيطانا (mufradat)\", \"n_sources\": 4, \"sole\": false, \"plain\": true, \"rare\": false}, \"B:quranic:root_000796:B005@10\": {\"type\": \"B\", \"node_id\": \"quranic:root_000796:B005\", \"word\": \"F:10\", \"root\": \"ش ط ن\", \"root_id\": \"root_000796\", \"bid\": \"B005\", \"root_kind\": \"identity\", \"gloss\": \"çirkin yılan ve bitki adıyla ürkütücü baş benzetmesi\", \"image\": \"القبيح المسمى شيطانا\", \"src\": \"الحية تسمى شيطانا (maqayis)؛ العرب تسمي الحية شيطانا ونبت قبيح يسمى رءوس الشياطين (sihah)؛ بعض الحيات شيطانا وهو حية ذو عرف قبيح المنظر والشيطان نبت قبيح يسمى برؤوس الشياطين (tahdhib)؛ كأنه رؤوس الشياطين قيل هي حية خفيفة الجسم وقيل أراد به عارم الجن فتشبه به لقبح تصورها (mufradat)\", \"n_sources\": 4, \"sole\": false, \"plain\": false, \"rare\": true}, \"F:11\": {\"type\": \"F\", \"surface\": \"أَعْمَٰلَهُمْ\", \"w\": 11, \"lemma\": \"عَمَل\", \"pos\": \"N;PRON\"}, \"B:quranic:root_001046:B001@11\": {\"type\": \"B\", \"node_id\": \"quranic:root_001046:B001\", \"word\": \"F:11\", \"root\": \"ع م ل\", \"root_id\": \"root_001046\", \"bid\": \"B001\", \"root_kind\": \"identity\", \"gloss\": \"bilerek yapılan iş veya eylem\", \"image\": \"الفعل المقصود والعمل\", \"src\": \"أصل واحد صحيح وهو عام في كل فعل يفعل (maqayis); عمل عملا فهو عامل (ayn;sihah;tahdhib); كل فعل يكون من الحيوان بقصد (mufradat); الأعمال الصالحة والسيئة (mufradat)\", \"n_sources\": 5, \"sole\": false, \"plain\": true, \"rare\": false}, \"B:quranic:root_001046:B002@11\": {\"type\": \"B\", \"node_id\": \"quranic:ro