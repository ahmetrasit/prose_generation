{
  "version": "v15",
  "sources": {
    "_comment": "Paths relative to /Volumes/OZTURK/_projects. Raw sources only; no earlier pipeline packets.",
    "quran_text": "quran-data/data/text/quran-uthmani.tsv",
    "root_ayah": "quran-slm/resources/source/qac_root_ayah.tsv",
    "branches": "quran-slm/resources/source/furuq_full_branches_ar.tsv",
    "tr_entries_glob": "quran-data/data/dictionary/tr/*_entry.json",
    "root_packets_dir": "dictionary/data/output/root_packets",
    "qiraat": "study/_project_corpus/qiraat.tsv",
    "pericopes": "quran-data/data/analysis/channels/network-v3/pericopes/surah_pericopes.jsonl",
    "inter_ayah_dir": "quran-data/data/analysis/inter-ayah",
    "root_alternatives": "quran-data/data/bridges/qac-dictionary-word-root-analyses.json",
    "channel_review": "quran-data/data/analysis/channels/network-v3/s{S:03d}/review/reader_a_pilot.md",
    "qnet_keywords": "quran-roots/_corpus/activation/Qnet/v2/network/incidence_full/branch_keywords.tsv"
  },
  "models": {
    "opus": {
      "cli": "claude",
      "model": "claude-opus-5-5",
      "effort": "high"
    },
    "luna": {
      "cli": "codex",
      "model": "gpt-6-luna",
      "effort": "max"
    }
  },
  "windows": {
    "local_radius": 7,
    "short_surah_max_ayat": 40
  },
  "concordance": {
    "kwic_max_uses": 30,
    "kwic_context_words": 3,
    "definition_chars": 100,
    "image_only_above_uses": 1000000,
    "_comment": "image_only_above_uses is effectively off: frequent roots are where readers hear only one sense, so their definitions stay."
  },
  "prose": {
    "ayah_words_target": 700,
    "ayah_words_cap": 1100,
    "max_images_per_ayah": 3
  },
  "jobs": {
    "frames_per_job": 60,
    "lemmas_per_loanword_job": 25,
    "profile_min_uses": 31,
    "profile_sample_max": 400
  },
  "gate": {
    "usd_per_call": 5.0,
    "usd_per_ayah": 5.0,
    "_comment": "Opus only: a call starts only when its estimate is below usd_per_call, and an ayah's calls stay within usd_per_ayah (tests). Never retried; once started it runs to the end. Luna runs on the flat Codex subscription and reports tokens, not dollars, so it is not gated."
  },
  "timeout_s": 5400,
  "pricing": {
    "opus_in_per_mtok": 4.0,
    "opus_out_per_mtok": 20.0,
    "opus_cache_read_per_mtok": 0.2,
    "cache_write_multiplier": 1.25,
    "_source": "claude-api skill model table (claude-opus-5-5: $4 in / $20 out per MTok, cache reads $0.20); thinking is billed as output"
  },
  "estimate_model": {
    "chars_per_token": 2.5,
    "cli_overhead_tokens": 15000,
    "tool_rounds": {
      "window": 6,
      "discover": 6,
      "write": 0,
      "surah": 0
    },
    "expected_output_tokens": {
      "window": 100000,
      "discover": 60000,
      "write": 20000,
      "surah": 60000
    },
    "_comment": "Used until the ledger has a reported cost for the step (then: the dearest earlier call of the step, scaled by prompt size). Deliberately generous on output/thinking tokens."
  }
}
